<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.mosip.kernel</groupId>
		<artifactId>audit-manager</artifactId>
		<version>1.4.1-SNAPSHOT</version>
	</parent>

	<artifactId>kernel-auditmanager-api</artifactId>
	<version>1.4.1-SNAPSHOT</version>
	<name>kernel-auditmanager-api</name>
	<description>
		Embeddable MOSIP audit library: JPA entity (audit.app_audit_log), AuditRepository,
		AuditRequestDto / AuditRequestBuilder, AuditUtils validation, and AuditHandlerImpl
		(persists validated events). Consume from other MOSIP services for in-process auditing,
		or transitively via kernel-auditmanager-service. JDK 21, Spring Boot 4.1.1, no kernel-bom.
		Depends on kernel-core.
	</description>
	<url>https://github.com/mosip/audit-manager</url>

	<properties>
		<sonar.coverage.exclusions>
			**/dto/**,**/constant/**,**/config/**,**/httpfilter/**,**/cache/**,**/entity/**,**/model/**,**/exception/**,**/repository/**,**/request/**,**/spi/**,**/proxy/**
		</sonar.coverage.exclusions>
		<!-- Child module .git is two levels up from kernel/kernel-auditmanager-api -->
		<git.commit.id.plugin.dotGitDirectory>${project.basedir}/../../.git</git.commit.id.plugin.dotGitDirectory>
	</properties>

	<dependencies>
		<!--
			kernel-core: MOSIP exceptions, AuditHandler SPI, logging SPI, HTTP wrappers.
			License: MPL-2.0. Version from parent DM (${kernel.core.version}).
		-->
		<dependency>
			<groupId>io.mosip.kernel</groupId>
			<artifactId>kernel-core</artifactId>
		</dependency>
		<!--
			spring-boot-starter-data-jpa: JPA repositories + Hibernate for Audit entity.
			Version from Boot parent 4.1.1. License: Apache-2.0.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!--
			spring-boot-starter-validation: Bean Validation (@NotNull/@Size on entity).
			Version from Boot parent. License: Apache-2.0.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!--
			h2: In-memory DB for local/tests (schema AUDIT). Dual EPL-1.0 OR MPL-2.0; MOSIP elects MPL-2.0.
			Scope: runtime.
		-->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!--
			postgresql: Production JDBC (optional at API compile for dialect awareness).
			License: BSD-2-Clause (PostgreSQL). Version ${postgresql.version}.
		-->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
		</dependency>
		<!--
			modelmapper: Bean in AuditConfig for optional DTO↔entity mapping.
			License: Apache-2.0. Version ${modelmapper.version} (2.4.5).
		-->
		<dependency>
			<groupId>org.modelmapper</groupId>
			<artifactId>modelmapper</artifactId>
		</dependency>
		<!--
			slf4j-api: Logging facade used alongside kernel-core Logger SPI.
			Version from Boot parent. License: MIT.
		-->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Library module — do not bind spring-boot:repackage (no main class). -->
			<plugin>
				<groupId>pl.project13.maven</groupId>
				<artifactId>git-commit-id-plugin</artifactId>
				<configuration>
					<dotGitDirectory>${project.basedir}/../../.git</dotGitDirectory>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<configuration>
					<skip>false</skip>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
